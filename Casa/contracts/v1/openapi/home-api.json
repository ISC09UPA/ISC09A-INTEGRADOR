  "components": {
    "securitySchemes": {
      "userBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT-user"
      },
      "captureUploadToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Capture-Token"
      },
      "videoProducerToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Video-Token",
        "description": "One-time producer secret delivered by Home through the authenticated StartVideo direct method. Only its SHA-256 hash is stored."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden or revoked",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "NotFound": {
        "description": "House, light or command not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate idempotency key with different content",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limited",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Dependency unavailable (Identity, IoT Hub, etc.)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      }
    }
  }
