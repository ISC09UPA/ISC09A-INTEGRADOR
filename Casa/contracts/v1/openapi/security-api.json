    "/security/houses/{houseId}/capture-retention": {
      "get": {
        "summary": "Get the administrative capture retention policy",
        "security": [
          {
            "userBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "houseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retention policy; null disables automatic deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "retentionDays"
                  ],
                  "properties": {
                    "retentionDays": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 3650
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or revoked session."
          },
          "403": {
            "description": "Not authorized."
          },
          "404": {
            "description": "Capture not found."
          },
          "503": {
            "description": "Service unavailable."
          }
        }
      },
      "put": {
        "summary": "Change capture retention; existing old captures may be deleted",
        "security": [
          {
            "userBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "houseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retention policy; null disables automatic deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "retentionDays"
                  ],
                  "properties": {
                    "retentionDays": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 3650
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or revoked session."
          },
          "403": {
            "description": "Not authorized."
          },
          "404": {
            "description": "Capture not found."
          },
          "503": {
            "description": "Service unavailable."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "retentionDays"
                ],
                "properties": {
                  "retentionDays": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 3650
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/security/houses/{houseId}/captures/{captureId}/deletion": {
      "get": {
        "summary": "Check whether an authorized deletion is pending, blocked or completed",
        "security": [
          {
            "userBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "houseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "captureId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "enum": [
                        "none",
                        "pending",
                        "blocked",
                        "deleted"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or revoked session."
          },
          "403": {
            "description": "Not authorized."
          },
          "404": {
            "description": "Capture not found."
          },
          "503": {
            "description": "Service unavailable."
          }
        }
      }
    },
