          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing, invalid or revoked session."
          },
          "403": {
            "description": "No administrative house permission."
          },
          "503": {
            "description": "Service unavailable."
          }
        }
      }
    }
