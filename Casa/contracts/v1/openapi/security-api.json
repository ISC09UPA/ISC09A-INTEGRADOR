    "/security/houses/{houseId}/mode": {
      "get": {
        "summary": "Current confirmed mode for the associated controller",
        "security": [
          {
            "userBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "houseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/security-mode.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or cursor."
          },
          "401": {
            "description": "Missing, invalid or revoked session."
          },
          "403": {
            "description": "No house permission."
          },
          "404": {
            "description": "No matching record or device report."
          },
          "503": {
            "description": "Required service unavailable."
          }
        }
      }
    },
