{
  "openapi": "3.1.0",
  "info": {
    "title": "Identity API",
    "description": "Casa Dom\u00f3tica Identity service v1. User sessions, JWKS and internal service-token endpoint.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5001/api/v1",
      "description": "Local dev"
    },
    {
      "url": "https://identity-api.example.com/api/v1",
      "description": "Azure dev (proposed, not operational)"
    }
  ],
  "paths": {
    "/identity/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Create a user session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/identity-login-request.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/identity-token-response.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/identity/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Rotate access token using refresh token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/identity-refresh-request.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/identity-token-response.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/identity/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke refresh token family",
        "description": "Accepts an opaque refresh token. Access token does not need to be valid or still present. Response is idempotent.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/identity-logout-request.json"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Revoked or unknown."
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/identity/me": {
      "get": {
        "operationId": "getMe",
        "summary": "User and authorized houses",
        "security": [
          {
            "userBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User context.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/identity-me-response.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/identity/.well-known/jwks.json": {
      "get": {
        "operationId": "getJwks",
        "summary": "Public signing keys",
        "security": [],
        "responses": {
          "200": {
            "description": "JWKS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/identity-jwks.json"
                }
              }
            }
          }
        }
      }
    },
    "/identity/internal/token": {
      "post": {
        "operationId": "exchangeServiceAssertion",
        "summary": "Exchange a signed service assertion",
        "description": "Home, Security, Notifications or Assistant authenticates with its independently pinned ES256 key. Identity issues a short-lived service token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/identity-service-token-request.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Service token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/identity-service-token-response.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/identity/internal/authz/check": {
      "post": {
        "operationId": "checkUserMembership",
        "summary": "Check whether a user/session may perform an action in a house",
        "description": "Authenticated services may request only their allowlisted actions. Identity checks the current user session and house membership; denied or revoked decisions return HTTP 403.",
        "security": [
          {
            "serviceBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/authz-check-request.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/authz-check-response.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/identity/houses/{houseId}/members": {
      "get": {
        "operationId": "listHouseMembers",
        "summary": "List house members and resident invitations",
        "security": [{ "userBearerAuth": [] }],
        "parameters": [
          { "name": "houseId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "House members and invitations.",
            "content": { "application/json": { "schema": { "$ref": "../schemas/identity-members-response.json" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/identity/houses/{houseId}/members/{memberUserId}": {
      "delete": {
        "operationId": "removeHouseResident",
        "summary": "Revoke resident membership and active sessions",
        "security": [{ "userBearerAuth": [] }],
        "parameters": [
          { "name": "houseId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "memberUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Resident removed and sessions revoked." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Member not found." },
          "409": { "description": "Administrator membership cannot be removed." }
        }
      }
    },
    "/identity/houses/{houseId}/invitations": {
      "post": {
        "operationId": "createResidentInvitation",
        "summary": "Invite a resident to a house",
        "security": [{ "userBearerAuth": [] }],
        "parameters": [
          { "name": "houseId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/identity-invitation-request.json" } } }
        },
        "responses": {
          "201": {
            "description": "Invitation created.",
            "content": { "application/json": { "schema": { "$ref": "../schemas/identity-invitation-created.json" } } }
          },
          "400": { "description": "Invalid request." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "House not found." },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/identity/houses/{houseId}/invitations/{invitationId}": {
      "delete": {
        "operationId": "revokeResidentInvitation",
        "summary": "Revoke a pending resident invitation",
        "security": [{ "userBearerAuth": [] }],
        "parameters": [
          { "name": "houseId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "invitationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Invitation revoked." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Pending invitation not found." }
        }
      }
    },
    "/identity/invitations/accept": {
      "post": {
        "operationId": "acceptResidentInvitation",
        "summary": "Accept a single-use resident invitation",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/identity-accept-invitation-request.json" } } }
        },
        "responses": {
          "200": { "description": "Invitation accepted." },
          "400": { "description": "Invalid request." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "description": "Invitation expired." },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/identity/auth/password/change": {
      "post": {
        "operationId": "changePassword",
        "summary": "Change authenticated user password and revoke active sessions",
        "security": [{ "userBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/identity-password-change-request.json" } } }
        },
        "responses": {
          "204": { "description": "Password updated and sessions revoked." },
          "400": { "description": "Invalid password format." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/identity/auth/password-reset/request": {
      "post": {
        "operationId": "requestPasswordReset",
        "summary": "Request a password reset without revealing whether an account exists",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/identity-password-reset-request.json" } } }
        },
        "responses": {
          "202": { "description": "Uniform accepted response." },
          "400": { "description": "Invalid email." },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/identity/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset",
        "summary": "Confirm single-use password reset token and revoke active sessions",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/identity-password-reset-confirm.json" } } }
        },
        "responses": {
          "204": { "description": "Password reset and sessions revoked." },
          "400": { "description": "Invalid input." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "description": "Reset token expired." },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT-user"
      },
      "serviceBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT-service"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized or invalid service credential",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Denied or revoked",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limited / lockout",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Identity unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/problem-details.json"
            }
          }
        }
      }
    }
  }
}
