{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/telemetry-envelope.json",
  "title": "Telemetry envelope v1",
  "description": "Common envelope for all device-to-cloud events. sourceDeviceId is assigned by Home Functions from authenticated IoT Hub metadata, never from JSON.",
  "type": "object",
  "required": ["schemaVersion", "type", "eventId", "occurredAtUtc", "correlationId", "payload"],
  "properties": {
    "schemaVersion": { "$ref": "common.json#/$defs/schemaVersion" },
    "type": {
      "type": "string",
      "enum": ["TelemetryReported", "MotionDetected", "CaptureUploaded", "AccessRequested", "CommandResult"]
    },
    "eventId": { "$ref": "common.json#/$defs/uuid" },
    "occurredAtUtc": { "$ref": "common.json#/$defs/dateTimeUtc" },
    "correlationId": { "$ref": "common.json#/$defs/correlationId" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "TelemetryReported" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["lightPercent", "motion", "lightOn", "securityModeApplied"],
            "properties": {
              "lightPercent": { "type": "number", "minimum": 0, "maximum": 100 },
              "motion": { "type": "boolean" },
              "lightOn": { "type": "boolean" },
              "securityModeApplied": { "type": "string", "enum": ["armed", "disarmed"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "MotionDetected" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["roomId", "securityModeApplied"],
            "properties": {
              "roomId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "securityModeApplied": { "type": "string", "enum": ["armed", "disarmed"] },
              "configurationVersion": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "CommandResult" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "command-result.json" }
        }
      }
    }
  ]
}
