{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/identity-password-reset-confirm.json",
  "title": "Identity Password Reset Confirm Request",
  "type": "object",
  "required": ["token", "email", "newPassword"],
  "properties": {
    "token": { "type": "string", "minLength": 16, "maxLength": 256 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "newPassword": { "type": "string", "minLength": 14, "maxLength": 128 }
  },
  "additionalProperties": false
}