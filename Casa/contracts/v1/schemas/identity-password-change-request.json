{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/identity-password-change-request.json",
  "title": "Identity Password Change Request",
  "type": "object",
  "required": ["currentPassword", "newPassword"],
  "properties": {
    "currentPassword": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "newPassword": { "type": "string", "minLength": 14, "maxLength": 128 }
  },
  "additionalProperties": false
}