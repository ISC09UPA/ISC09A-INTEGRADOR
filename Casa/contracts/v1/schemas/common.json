{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/common.json",
  "title": "Common definitions for Casa Dom\u00f3tica contracts v1",
  "description": "Reusable primitives. All dates are UTC ISO-8601. Identifiers are opaque UUIDv4 strings unless noted.",
  "type": "object",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Opaque identifier, UUIDv4 preferred."
    },
    "dateTimeUtc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant in ISO-8601 with Z suffix or explicit +00:00 offset."
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "correlationId": {
      "$ref": "#/$defs/uuid",
      "description": "Ties a request, device event and downstream side-effects together."
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Idempotency key generated by Home API."
    },
    "commandSequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic sequence per light generated by Home API; serialized by Pi."
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "IoT Hub device identity. Used as an additional destination check, never as the sole authority."
    },
    "houseId": {
      "$ref": "#/$defs/uuid",
      "description": "House identifier from Identity service."
    },
    "lightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque room/light identifier within a house."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Major schema version of the envelope. Explicit compatibility gate."
    },
    "permission": {
      "type": "string",
      "enum": [
        "home:read",
        "home:control:lights",
        "home:control:security",
        "home:control:door",
        "home:control:capture",
        "security:read",
        "security:manage",
        "notifications:read",
        "notifications:manage",
        "assistant:read",
        "identity:manage:members",
        "identity:authorize"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "resident"
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "Identity.Public",
        "Home.Public",
        "Security.Public",
        "Notifications.Public",
        "Assistant.Public",
        "Identity.Internal",
        "Home.Internal"
      ],
      "description": "Explicit audience values. No wildcards."
    },
    "reasonCode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "invalidPayload",
        "unauthorized",
        "forbidden",
        "duplicateChanged",
        "sequenceRejected",
        "deviceRejected",
        "expired",
        "unknown",
        "failed"
      ],
      "description": "null for pending/executed; specific code for terminal error states."
    },
    "problemDetails": {
      "type": "object",
      "required": [
        "type",
        "title",
        "status",
        "correlationId",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "correlationId": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalidCredential",
            "forbidden",
            "sessionRevoked",
            "serviceUnavailable",
            "rateLimited",
            "notFound",
            "conflict",
            "badRequest",
            "pendingCommand",
            "manualModeRequired",
            "duplicateChanged",
            "deviceOffline",
            "requestExpired",
            "noReport"
          ]
        }
      },
      "additionalProperties": false
    },
    "paging": {
      "type": "object",
      "properties": {
        "continuationToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "jwtHeader": {
      "type": "object",
      "required": [
        "alg",
        "typ",
        "kid"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "ES256"
          ]
        },
        "typ": {
          "const": "JWT"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque capability identifier resolved and authorized within a house."
    }
  }
}
