{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/home-security-status.json",
  "title": "Applied security mode v1",
  "type": "object",
  "required": [
    "mode",
    "updatedAtUtc",
    "receivedAtUtc"
  ],
  "properties": {
    "mode": {
      "enum": [
        "armed",
        "disarmed"
      ]
    },
    "updatedAtUtc": {
      "$ref": "common.json#/$defs/dateTimeUtc"
    },
    "receivedAtUtc": {
      "$ref": "common.json#/$defs/dateTimeUtc"
    }
  },
  "additionalProperties": false
}
