{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/security-mode.json",
  "title": "Security Mode",
  "type": "object",
  "required": [
    "mode",
    "updatedAtUtc",
    "receivedAtUtc",
    "incident"
  ],
  "properties": {
    "mode": {
      "enum": [
        "armed",
        "disarmed"
      ]
    },
    "updatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "receivedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "incident": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "occurredAtUtc",
            "receivedAtUtc"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "occurredAtUtc": {
              "type": "string",
              "format": "date-time"
            },
            "receivedAtUtc": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
