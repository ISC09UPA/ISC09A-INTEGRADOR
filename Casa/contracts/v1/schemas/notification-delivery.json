{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrador9nocuatri.local/contracts/v1/schemas/notification-delivery.json",
  "title": "Notification Delivery",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "test",
        "event",
        "verification"
      ]
    },
    "status": {
      "enum": [
        "requested",
        "accepted",
        "failed",
        "unknown",
        "delivered"
      ]
    },
    "providerOperationId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "createdAtUtc": {
      "$ref": "common.json#/$defs/dateTimeUtc"
    },
    "updatedAtUtc": {
      "$ref": "common.json#/$defs/dateTimeUtc"
    }
  },
  "additionalProperties": false
}
