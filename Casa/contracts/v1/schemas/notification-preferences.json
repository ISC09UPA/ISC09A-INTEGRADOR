{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/notification-preferences.json",
  "title": "Notification Preferences",
  "type": "object",
  "required": [
    "email"
  ],
  "properties": {
    "email": {
      "type": "boolean"
    },
    "verifiedEmail": {
      "type": [
        "string",
        "null"
      ],
      "format": "email",
      "maxLength": 254
    },
    "verifiedAtUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pendingRecipientEmail": {
      "type": [
        "string",
        "null"
      ],
      "format": "email",
      "maxLength": 254
    },
    "updatedAtUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
