{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-example.local/contracts/v1/schemas/identity-token-response.json",
  "title": "Identity token response v1",
  "description": "User session creation/refresh response. Tokens are illustrative strings, not real secrets.",
  "type": "object",
  "required": ["accessToken", "refreshToken", "expiresIn", "refreshExpiresIn", "sessionId", "userId"],
  "properties": {
    "accessToken": { "type": "string" },
    "refreshToken": { "type": "string" },
    "expiresIn": { "type": "integer", "const": 300 },
    "refreshExpiresIn": { "type": "integer", "minimum": 0, "maximum": 604800, "description": "Remaining lifetime of the fixed seven-day session family." },
    "sessionId": { "$ref": "common.json#/$defs/uuid" },
    "userId": { "$ref": "common.json#/$defs/uuid" }
  },
  "additionalProperties": false
}
