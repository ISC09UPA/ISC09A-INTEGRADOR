{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrador9nocuatri.local/contracts/v1/schemas/home-command-resource.json",
  "title": "Home command resource v1",
  "description": "Light or capability command resource.",
  "oneOf": [
    {
      "$ref": "#/$defs/light"
    },
    {
      "$ref": "capability-command-resource.json"
    }
  ],
  "$defs": {
    "light": {
      "description": "Resource returned by GET /commands/{commandId} and by terminal replay. Contains house/light association for authorization and either a pending state or the durable Pi result. Terminal states require a non-null result object whose status matches the resource status. C10 invariant: result.commandId and result.type must equal the resource commandId and type (enforced by semantic checker, not JSON Schema equality).",
      "type": "object",
      "required": [
        "commandId",
        "houseId",
        "lightId",
        "status",
        "type",
        "requestedAtUtc",
        "correlationId"
      ],
      "properties": {
        "commandId": {
          "$ref": "common.json#/$defs/commandId"
        },
        "houseId": {
          "$ref": "common.json#/$defs/houseId"
        },
        "lightId": {
          "$ref": "common.json#/$defs/lightId"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "executed",
            "rejected",
            "expired",
            "unknown",
            "failed"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "SetLight",
            "SetLightingMode"
          ]
        },
        "requestedAtUtc": {
          "$ref": "common.json#/$defs/dateTimeUtc"
        },
        "correlationId": {
          "$ref": "common.json#/$defs/correlationId"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "command-result.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "executed"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "executed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "rejected"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "expired"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "expired"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "unknown"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
