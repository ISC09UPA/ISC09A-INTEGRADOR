{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrador9nocuatri.local/contracts/v1/schemas/authz-check-response.json",
  "title": "User membership authorization check response body v1",
  "description": "HTTP 200 response body for /identity/internal/authz/check. Denied/revoked are returned as HTTP 403 ProblemDetails; unavailable as HTTP 503 ProblemDetails.",
  "type": "object",
  "required": [
    "decision",
    "checkedAtUtc",
    "correlationId",
    "userId",
    "sessionId",
    "houseId",
    "action"
  ],
  "properties": {
    "decision": {
      "const": "allowed"
    },
    "checkedAtUtc": {
      "$ref": "common.json#/$defs/dateTimeUtc"
    },
    "correlationId": {
      "$ref": "common.json#/$defs/correlationId"
    },
    "userId": {
      "$ref": "common.json#/$defs/uuid"
    },
    "sessionId": {
      "$ref": "common.json#/$defs/uuid"
    },
    "houseId": {
      "$ref": "common.json#/$defs/houseId"
    },
    "action": {
      "enum": [
        "home:read",
        "home:control:lights",
        "home:control:security",
        "home:control:door",
        "home:control:capture",
        "security:read",
        "security:manage",
        "notifications:read",
        "notifications:manage",
        "assistant:read",
        "identity:manage:members"
      ]
    }
  },
  "additionalProperties": false
}
