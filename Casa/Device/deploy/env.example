# Configuración del agente. Copiar a /etc/casa-pi/agent.env con permisos 600.
# No versionar el archivo real: contiene la cadena de conexión del dispositivo.

# Identidad del dispositivo (debe coincidir con IoT Hub y con el binding de Home)
CASA_DEVICE_ID=casa-pi-01
CASA_LIGHT_ID=sala
CASA_DOOR_ID=puerta

# Enlace serie con la placa de E/S
CASA_SERIAL_PORT=/dev/ttyUSB0
CASA_SERIAL_BAUD=115200

# Estado durable
CASA_DB_PATH=/var/lib/casa-pi/agent-state.db
CASA_REPORT_INTERVAL_S=30
CASA_LIGHTING_MODE=manual
CASA_SECURITY_MODE=disarmed
# 0 si el LDR no está instalado: publica lightPercent=0 en vez de ruido del pin
CASA_LDR_ENABLED=1

# Transporte: iot (producción) | local (pruebas con el doble de Home)
CASA_TRANSPORT=iot
CASA_IOT_CONNECTION_STRING=

# Cámara: auto (CSI si existe, si no v4l2) | csi | v4l2 | none
CASA_CAMERA_BACKEND=auto
CASA_CAMERA_DEVICE=/dev/video0

# Solo para CASA_TRANSPORT=local
CASA_LOCAL_HOST=127.0.0.1
CASA_LOCAL_PORT=8765
CASA_LOCAL_HOME_URL=http://127.0.0.1:9000/events
