{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "serviceBus": {
      "autoCompleteMessages": false,
      "maxConcurrentCalls": 1
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function.ConsumeNotificationEvents": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true
      }
    }
  }
}
