# Cadena SAS exclusiva para Raspberry: Receive en locker-commands y Send en locker-events
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://TU_NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RASPBERRY;SharedAccessKey=REEMPLAZAR
COMMANDS_QUEUE=locker-commands
EVENTS_QUEUE=locker-events
LOCKER_CODE=L-01
# true para pruebas sin pines reales; false cuando configures los GPIO
SIMULATION_MODE=true
# No asignar hasta confirmar el esquema eléctrico y la numeración BCM
RELAY_GPIO=
DOOR_SENSOR_GPIO=
PRESENCE_SENSOR_GPIO=
RELAY_ACTIVE_HIGH=true
DOOR_CLOSED_ACTIVE_HIGH=true
PRESENCE_ACTIVE_HIGH=true
RELAY_PULSE_SECONDS=1.0
DOOR_CONFIRM_TIMEOUT_SECONDS=5.0
DATABASE_PATH=./device_state.sqlite3
