        <mxCell id="cierre" value="Si estaba regando, guardar el riego&lt;br&gt;Apagar bomba, ventilador y LEDs&lt;br&gt;Cerrar base de datos, DHT22, BH1750 y cámara" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="390" y="2010" width="300" height="80" as="geometry"/></mxCell>
