        <mxCell id="leyenda" value="&lt;b&gt;Valores de config.py&lt;/b&gt;&lt;br&gt;HUMEDAD_MINIMA = 35 %&lt;br&gt;HUMEDAD_OBJETIVO = 60 %&lt;br&gt;NIVEL_MINIMO = 10 %&lt;br&gt;TIEMPO_MAX_BOMBA_S = 10&lt;br&gt;ESPERA_ENTRE_RIEGOS_S = 300&lt;br&gt;TEMP_VENT_ON / OFF = 30 / 28 °C&lt;br&gt;INTERVALO_LECTURA_S = 60&lt;br&gt;INTERVALO_FOTO_S = 3600" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="220" height="170" as="geometry"/></mxCell>
