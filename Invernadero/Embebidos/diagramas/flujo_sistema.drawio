<mxfile host="drawio">
  <diagram id="flujo" name="Flujo del sistema">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="inicio" value="Inicio&lt;br&gt;(python main.py)" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="init" value="Inicializar sensores: DHT22, ADS1115 (humedad / nivel), BH1750, flotador y caudalímetro&lt;br&gt;Inicializar actuadores: relés de bomba y ventilador y LEDs" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="cam" value="¿Cámara&lt;br&gt;disponible?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="240" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="sincam" value="Avisar &quot;Cámara no disponible&quot;&lt;br&gt;y seguir sin fotos" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="255" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="listo" value="Encender LED verde&lt;br&gt;Iniciar hilo de la terminal" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="380" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="leer" value="Leer sensores: temperatura (cada 2 s), humedad, nivel, luz, flotador y caudal (L/min cada 1 s)" style="whiteSpace=wrap;html=1;fontSize=12;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="370" y="490" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="ind" value="LED rojo = error de sensor (DHT22 falló 3 veces o falló la humedad)&lt;br&gt;Sin agua = flotador vacío o nivel &amp;lt; 10 %" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="600" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="bomba" value="¿Bomba&lt;br&gt;encendida?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="710" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="parar" value="¿Sin agua, pasaron 10 s&lt;br&gt;o humedad ≥ 60 %&lt;br&gt;(si no es manual)?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="apagar" value="Apagar bomba y LED azul&lt;br&gt;Calcular duración y mL&lt;br&gt;Guardar riego en SQLite" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="50" y="1020" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="agua" value="¿Hay agua?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810" y="840" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="arrancar" value="¿Riego manual o&lt;br&gt;(humedad &amp;lt; 35 % y&lt;br&gt;pasaron 300 s)?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="980" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="encender" value="Encender bomba y LED azul&lt;br&gt;Guardar inicio y pulsos" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="780" y="1150" width="240" height="70" as="geometry"/></mxCell>
