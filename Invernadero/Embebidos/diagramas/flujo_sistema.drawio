        <mxCell id="vent" value="Ventilador con histéresis:&lt;br&gt;ON si T ≥ 30 °C · OFF si T ≤ 28 °C&lt;br&gt;(sin lectura no cambia)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="1290" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="reporte" value="Imprimir estado en la terminal (cada 1 s)" style="whiteSpace=wrap;html=1;fontSize=12;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="1410" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="envio" value="¿Pasaron&lt;br&gt;60 s?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="1510" width="160" height="90" as="geometry"/></mxCell>
