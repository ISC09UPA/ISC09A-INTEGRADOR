{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "ComputerVision": {
      "Endpoint": "https://centralus.api.cognitive.microsoft.com/",
      "SubscriptionKey": "YOUR_AZURE_VISION_KEY",
      "Region": "centralus"
    },
    "CommunicationServices": {
      "Endpoint": "https://comunicacion9no.unitedstates.communication.azure.com/",
      "AccessKey": "YOUR_AZURE_COMMUNICATION_KEY",
      "ConnectionString": "endpoint=https://comunicacion9no.unitedstates.communication.azure.com/;accesskey=YOUR_ACCESS_KEY"
    },
    "ServiceBus": {
      "ConnectionString": "Endpoint=sb://bus9no.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_KEY",
      "Namespace": "bus9no",
      "KeyName": "RootManageSharedAccessKey",
      "Key": "YOUR_AZURE_SERVICE_BUS_KEY",
      "QueueName": "estacionamiento-events"
    },
    "BlobStorage": {
      "AccountName": "storage9no",
      "AccountKey": "YOUR_AZURE_STORAGE_KEY",
      "ContainerName": "lpr-evidencias",
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=storage9no;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"
    }
  }
}
