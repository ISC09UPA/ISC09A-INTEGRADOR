# ==============================================================================
# ESTACIONAMIENTO INTELIGENTE - AZURE CLOUD CONFIGURATION (TEMPLATE)
# Copia este archivo a .env y completa tus credenciales.
# ==============================================================================

# 1. Azure Computer Vision (LPR Plate Recognition & OCR)
AZURE_COMPUTER_VISION_KEY=tu_azure_computer_vision_key
AZURE_COMPUTER_VISION_ENDPOINT=https://centralus.api.cognitive.microsoft.com/
AZURE_COMPUTER_VISION_REGION=centralus

# 2. Azure Communication Services (Security Alerts & Notifications)
AZURE_COMMUNICATION_KEY=tu_communication_service_key
AZURE_COMMUNICATION_ENDPOINT=https://comunicacion9no.unitedstates.communication.azure.com/
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://comunicacion9no.unitedstates.communication.azure.com/;accesskey=...

# 3. Azure Service Bus (IoT Bay Telemetry & Access/Barrier Events)
AZURE_SERVICE_BUS_KEY=tu_service_bus_key
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://bus9no.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=...
AZURE_SERVICE_BUS_NAMESPACE=bus9no
AZURE_SERVICE_BUS_QUEUE=estacionamiento-events

# 4. Azure Blob Storage (LPR Evidence Photos & Plate Snapshots)
AZURE_STORAGE_KEY=tu_blob_storage_key
AZURE_STORAGE_ACCOUNT=storage9no
AZURE_STORAGE_CONTAINER=lpr-evidencias
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=storage9no;AccountKey=...;EndpointSuffix=core.windows.net

