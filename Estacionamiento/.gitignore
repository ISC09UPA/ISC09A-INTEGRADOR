# ------------------------------------------------------------------------------
# 1. Secretos, Credenciales y Certificados Sensibles (MÁXIMA SEGURIDAD)
# ------------------------------------------------------------------------------
# Variables de entorno
.env
.env.*
!.env.example
*.env

# Certificados criptográficos, claves privadas y firmas
*.pem
*.pfx
*.cer
*.crt
*.key
*.p12
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Certificados del agente Edge (Raspberry Pi mTLS)
edge/certs/*
!edge/certs/.gitkeep
edge/config.json
!edge/config.example.json
edge/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Configuración de servicios en la nube y móviles con secretos
*.publishsettings
azure.json
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist
*.mobileprovision

# ------------------------------------------------------------------------------
# 2. .NET / C#
# ------------------------------------------------------------------------------
bin/
obj/
*.suo
*.user
*.userosscache
*.sln.docstates
appsettings.*.local.json
appsettings.Local.json
appsettings.secrets.json
secrets.json
TestResults/
.vs/
_ReSharper*/

# ------------------------------------------------------------------------------
