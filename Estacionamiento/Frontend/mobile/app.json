{
  "expo": {
    "name": "AeroPark",
    "slug": "aeropark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo/aeropark_logo_mark.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/logo/aeropark_logo_stacked.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aeropark.mobility",
      "infoPlist": {
        "NSFaceIDUsageDescription": "AeroPark utiliza Face ID para autenticar de forma segura el acceso vehicular y pagos con un toque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo/aeropark_logo_mark.png",
        "backgroundColor": "#000000"
      },
      "package": "com.aeropark.mobility",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA"]
    },
    "web": {
      "favicon": "./src/assets/logo/aeropark_logo_mark_small.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite a AeroPark autenticar con Face ID."
        }
      ]
    ]
  }
}
