@* translate="no": el traductor del navegador reescribe el DOM y rompe el render de Blazor (insertBefore of null). *@
<!DOCTYPE html>
<html lang="es" translate="no">

<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AlmacenInteligente.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @* Contenedor propio: si una extensión del navegador inserta nodos en <body>, no quedan entre los marcadores de Blazor. *@
    <div id="app">
        <Routes @rendermode="PageRenderMode" />
    </div>
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Las páginas de cuenta (inicio de sesión) se sirven sin interactividad para poder escribir la cookie.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
